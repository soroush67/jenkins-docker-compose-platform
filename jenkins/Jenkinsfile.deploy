// paas/deploy-compose - developer self-service deploy.
//
//   upload docker-compose.yml  ->  approval (services.yaml approvers, never
//   the requester)  ->  commit to the service's repo/branch/path  ->  deploy
//   that commit to the service's target host with Ansible.
//
// The job and its parameters (SERVICE, COMPOSE_FILE, CHANGE_NOTE) are
// generated by paas-admin/sync-registry (jenkins/jobs.groovy).

def registry      // jenkins/registry.groovy
def svc           // services.yaml entry for params.SERVICE
def requester
def approver

pipeline {
    agent none
    options {
        timestamps()
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '200'))
    }
    stages {
        stage('Request') {
            agent { label 'paas' }
            steps {
                script {
                    def cause = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
                    requester = cause ? cause[0].userId : null
                    if (!requester) {
                        error('This job must be started by a logged-in user (Build with Parameters).')
                    }
                    checkout scm
                    registry = load 'jenkins/registry.groovy'
                    svc = registry.service(params.SERVICE)

                    // file-parameters: the upload is stashed under the
                    // parameter name and unstashes as a file of that name.
                    unstash 'COMPOSE_FILE'
                    if (!fileExists('COMPOSE_FILE') || readFile('COMPOSE_FILE').trim().isEmpty()) {
                        error('No docker-compose.yml was uploaded (COMPOSE_FILE is empty).')
                    }
                    stash name: 'compose', includes: 'COMPOSE_FILE'
                    currentBuild.description = "${svc.name} - requested by ${requester}"

                    echo """
==================== deploy request ====================
service      : ${svc.name}
requested by : ${requester}
change note  : ${params.CHANGE_NOTE ?: '-'}
git target   : ${svc.repo}  (branch ${svc.branch})  ${svc.path}
deploy to    : ${svc.target_host}:${svc.deploy_dir}
approvers    : ${svc.approvers.join(', ')}
------------------ uploaded docker-compose.yml ------------------
${readFile('COMPOSE_FILE')}
=========================================================="""
                }
            }
            post { always { deleteDir() } }
        }

        stage('Approval') {
            // No agent: waiting for a human must not hold an executor.
            steps {
                script {
                    // The requester can never approve their own deploy, even
                    // when they are listed as an approver themselves.
                    def allowed = svc.approvers.findAll { it != requester }
                    if (allowed.isEmpty()) {
                        error("No approver other than ${requester} is configured for ${svc.name} in services.yaml.")
                    }
                    timeout(time: 24, unit: 'HOURS') {
                        approver = input(
                            id: 'Approve',
                            message: "Deploy ${svc.name} to ${svc.target_host} (requested by ${requester})? " +
                                     "The uploaded file is printed above in this build's console.",
                            ok: 'Approve & deploy',
                            submitter: allowed.join(','),
                            submitterParameter: 'APPROVER')
                    }
                    // Belt and braces: Jenkins admins may approve any input
                    // regardless of `submitter`, so check again here.
                    if (approver == requester) {
                        error("${approver} requested this deploy and cannot approve it.")
                    }
                    echo "Approved by ${approver}"
                    currentBuild.description = "${svc.name} - requested by ${requester}, approved by ${approver}"
                }
            }
        }

        stage('Commit & deploy') {
            agent { label 'paas' }
            steps {
                // One deploy per service at a time; different services in parallel.
                lock(resource: "compose-paas:${svc.name}") {
                    script {
                        checkout scm
                        registry = load 'jenkins/registry.groovy'
                        unstash 'compose'

                        writeFile file: '.commit-msg', text:
                            "deploy(${svc.name}): ${params.CHANGE_NOTE ?: 'update docker-compose.yml'}\n\n" +
                            "Requested-by: ${requester}\nApproved-by: ${approver}\nJenkins-build: ${env.BUILD_URL}\n"

                        withEnv(["SVC_REPO=${svc.repo}", "SVC_BRANCH=${svc.branch}", "SVC_PATH=${svc.path}",
                                 "REQUESTER=${requester}"]) {
                            registry.withGitAuth {
                                // Fresh clone inside the lock, so a push never
                                // races another deploy of the same service.
                                sh '''
                                    set -eu
                                    rm -rf _svc
                                    git clone -q --branch "$SVC_BRANCH" "$SVC_REPO" _svc 2>/dev/null \
                                      || { git clone -q "$SVC_REPO" _svc && git -C _svc checkout -q -B "$SVC_BRANCH"; }
                                    mkdir -p "_svc/$(dirname "$SVC_PATH")"
                                    cp COMPOSE_FILE "_svc/$SVC_PATH"
                                    cd _svc
                                    git add -- "$SVC_PATH"
                                    if git diff --cached --quiet; then
                                        echo "docker-compose.yml is identical to $SVC_BRANCH:$SVC_PATH - nothing to commit, redeploying it as is."
                                    else
                                        git -c user.name="Jenkins (compose-paas)" -c user.email="jenkins-bot@compose-paas.local" \
                                            commit -q -F ../.commit-msg --author="$REQUESTER <$REQUESTER@users.compose-paas>"
                                        git push -q origin "HEAD:$SVC_BRANCH"
                                        echo "Committed and pushed:"
                                        git log -1 --format='  %H%n  author %an, %ad'
                                    fi
                                '''
                            }
                        }
                        def commit = sh(returnStdout: true, script: 'git -C _svc rev-parse HEAD').trim()

                        writeJSON file: '.deploy-vars.json', json: [
                            service_name: svc.name,
                            compose_src : "${pwd()}/_svc/${svc.path}".toString(),
                            deploy_dir  : svc.deploy_dir,
                            git_repo    : svc.repo,
                            git_branch  : svc.branch,
                            git_path    : svc.path,
                            git_commit  : commit,
                            requested_by: requester,
                            approved_by : approver,
                            jenkins_build: env.BUILD_URL ?: '',
                        ]
                        withCredentials([sshUserPrivateKey(credentialsId: env.PAAS_SSH_CRED,
                                                           keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                            withEnv(["TARGET_HOST=${svc.target_host}",
                                     // Lab default. Production: pin host keys
                                     // (known_hosts on the agent) and set this true.
                                     "ANSIBLE_HOST_KEY_CHECKING=${env.PAAS_HOST_KEY_CHECKING ?: 'False'}",
                                     'ANSIBLE_FORCE_COLOR=0']) {
                                sh '''
                                    set -eu
                                    ansible-playbook -i "$TARGET_HOST," ansible/deploy-compose.yml \
                                      -u "$SSH_USER" --private-key "$SSH_KEY" -e @.deploy-vars.json
                                '''
                            }
                        }
                        echo "Deployed ${svc.name} @ ${commit.take(10)} to ${svc.target_host}:${svc.deploy_dir}"
                    }
                }
            }
            post { always { deleteDir() } }
        }
    }
}
