// paas-admin/sync-registry - admin only.
// Validates services.yaml and (re)generates the developer jobs in the
// `paas` folder so their SERVICE dropdown matches the registry. Run it after
// every registry change (or point a GitLab webhook / SCM poll at it).

pipeline {
    agent { label 'paas' }
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }
    stages {
        stage('Validate registry & generate jobs') {
            steps {
                script {
                    def registry = load 'jenkins/registry.groovy'
                    def reg = registry.readRegistry()      // fails on any invalid entry
                    def names = reg.services.keySet().toList().sort()
                    def lines = names.collect { n ->
                        def s = reg.services[n]
                        "  ${n}${s.description ? ' - ' + s.description : ''}  ->  ${s.target_host}:${s.deploy_dir}  (approvers: ${s.approvers.join(', ')})"
                    }
                    echo "Services in the registry:\n${lines.join('\n')}"

                    jobDsl(targets: 'jenkins/jobs.groovy',
                           removedJobAction: 'IGNORE',
                           removedViewAction: 'IGNORE',
                           additionalParameters: [
                               SERVICES        : names,
                               SERVICE_LINES   : lines,
                               PIPELINE_REPO   : env.PAAS_PIPELINE_REPO,
                               PIPELINE_BRANCH : env.PAAS_PIPELINE_BRANCH ?: 'main',
                               GIT_CRED        : env.PAAS_GIT_CRED,
                           ])
                }
            }
        }
    }
    post { always { deleteDir() } }
}
