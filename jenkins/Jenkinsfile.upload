// cd/upload-compose - upload a docker-compose.yml from your machine; Jenkins
// writes it to the selected existing path in the CD repository and pushes.
// Parameters (TARGET, COMPOSE_FILE, CHANGE_NOTE) are generated by
// cd-admin/refresh-paths (jenkins/jobs.groovy).

pipeline {
    agent { label 'cd' }
    options {
        timestamps()
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '300'))
    }
    stages {
        stage('Upload to git') {
            steps {
                script {
                    def cause = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
                    def uploader = cause ? cause[0].userId : null
                    if (!uploader) {
                        error('This job must be started by a logged-in user (Build with Parameters).')
                    }
                    def target = params.TARGET ?: ''
                    currentBuild.description = "${target} - by ${uploader}"

                    checkout scm
                    def cd = load 'jenkins/cdrepo.groovy'

                    // file-parameters: the upload unstashes as a file named
                    // after the parameter.
                    unstash 'COMPOSE_FILE'
                    if (!fileExists('COMPOSE_FILE') || readFile('COMPOSE_FILE').trim().isEmpty()) {
                        error('No file was uploaded (COMPOSE_FILE is empty).')
                    }

                    writeFile file: '.commit-msg', text:
                        "${target}: ${params.CHANGE_NOTE ?: 'update via Jenkins upload'}\n\n" +
                        "Uploaded-by: ${uploader}\nJenkins-build: ${env.BUILD_URL}\n"

                    // One upload per repo/branch at a time: clone -> commit ->
                    // push never interleaves with another upload.
                    lock(resource: "compose-cd:${env.CD_REPO}#${cd.branch()}") {
                        cd.cloneRepo('_cd')
                        cd.requireComposePath('_cd', target)

                        echo """
==================== upload ====================
repository  : ${env.CD_REPO}  (branch ${cd.branch()})
path        : ${target}
uploaded by : ${uploader}
change note : ${params.CHANGE_NOTE ?: '-'}
--------------- uploaded file ---------------
${readFile('COMPOSE_FILE')}
================================================"""

                        def result = ''
                        withEnv(["TARGET_PATH=${target}", "UPLOADER=${uploader}", "PUSH_BRANCH=${cd.branch()}"]) {
                            cd.withGitAuth {
                                result = sh(returnStdout: true, script: '''
                                    set -eu
                                    cp COMPOSE_FILE "_cd/$TARGET_PATH"
                                    cd _cd
                                    git add -- "$TARGET_PATH"
                                    if git diff --cached --quiet; then
                                        echo "UNCHANGED"
                                        exit 0
                                    fi
                                    git --no-pager diff --cached --stat >&2
                                    # committer = Jenkins (also needed by the rebase below), author = uploader
                                    git config user.name "Jenkins (compose-cd)"
                                    git config user.email "jenkins-bot@compose-cd.local"
                                    git commit -q -F ../.commit-msg --author="$UPLOADER <$UPLOADER@users.compose-cd>"
                                    # Someone may push straight to the repo while we work:
                                    # rebase our single-file commit on top and retry.
                                    for attempt in 1 2 3; do
                                        if git push -q origin "HEAD:$PUSH_BRANCH" >&2; then
                                            git rev-parse HEAD
                                            exit 0
                                        fi
                                        echo "push rejected (attempt $attempt) - rebasing on the latest $PUSH_BRANCH" >&2
                                        git pull -q --rebase origin "$PUSH_BRANCH" >&2
                                    done
                                    echo "push failed 3 times" >&2
                                    exit 1
                                ''').trim()
                            }
                        }
                        if (result == 'UNCHANGED') {
                            echo "The uploaded file is identical to ${target} in git - nothing to commit."
                            currentBuild.description = "${target} - by ${uploader} (unchanged)"
                        } else {
                            echo "Pushed ${target} to ${cd.branch()} as commit ${result}\n${cd.commitUrl(result)}"
                            currentBuild.description = "${target} - by ${uploader} @ ${result.take(8)}"
                        }
                    }
                }
            }
        }
    }
    post { always { deleteDir() } }
}
