// cd/show-compose - fetch a compose file from the CD repository and print it
// in the console output. Read-only. TARGET is generated by
// cd-admin/refresh-paths.

pipeline {
    agent { label 'cd' }
    options {
        timestamps()
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '100'))
    }
    stages {
        stage('Fetch & show') {
            steps {
                script {
                    def target = params.TARGET ?: ''
                    currentBuild.description = target

                    checkout scm
                    def cd = load 'jenkins/cdrepo.groovy'
                    cd.cloneRepo('_cd')
                    cd.requireComposePath('_cd', target)

                    def last = ''
                    withEnv(["TARGET_PATH=${target}"]) {
                        last = sh(returnStdout: true,
                                  script: 'git -C _cd log -1 --format="%h  %ad  by %an%n%s%n%b" --date=iso -- "$TARGET_PATH"').trim()
                    }
                    echo """
==================== ${target} ====================
repository  : ${env.CD_REPO}  (branch ${cd.branch()})
last change : ${last}
---------------------------------------------------
${readFile("_cd/${target}")}
==================================================="""
                }
            }
        }
    }
    post { always { deleteDir() } }
}
