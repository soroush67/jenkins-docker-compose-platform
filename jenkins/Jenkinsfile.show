// paas/show-compose - fetch a service's docker-compose.yml from its git
// repo and print it in the console. Read-only; no approval needed.
// Job + SERVICE parameter generated by paas-admin/sync-registry.

pipeline {
    agent { label 'paas' }
    options {
        timestamps()
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '100'))
    }
    stages {
        stage('Fetch & show') {
            steps {
                script {
                    checkout scm
                    def registry = load 'jenkins/registry.groovy'
                    def svc = registry.service(params.SERVICE)
                    currentBuild.description = svc.name

                    withEnv(["SVC_REPO=${svc.repo}", "SVC_BRANCH=${svc.branch}", "SVC_PATH=${svc.path}"]) {
                        registry.withGitAuth {
                            sh '''
                                set -eu
                                rm -rf _svc
                                git clone -q --branch "$SVC_BRANCH" "$SVC_REPO" _svc
                            '''
                        }
                        if (!fileExists("_svc/${svc.path}")) {
                            echo "No docker-compose.yml yet at ${svc.repo} ${svc.branch}:${svc.path} - nothing has been deployed through compose-paas for this service."
                            currentBuild.result = 'UNSTABLE'
                            return
                        }
                        def last = sh(returnStdout: true,
                                      script: 'git -C _svc log -1 --format="%h  %ad  by %an%n%s%n%b" --date=iso -- "$SVC_PATH"').trim()
                        echo """
==================== ${svc.name} ====================
repo        : ${svc.repo}
branch/path : ${svc.branch}:${svc.path}
deployed to : ${svc.target_host}:${svc.deploy_dir}
last change : ${last}
--------------------- docker-compose.yml ---------------------
${readFile("_svc/${svc.path}")}
=============================================================="""
                    }
                }
            }
        }
    }
    post { always { deleteDir() } }
}
